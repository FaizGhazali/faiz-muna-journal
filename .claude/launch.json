{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "journal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5000,
      "autoPort": false
    },
    {
      "name": "hosting",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase",
        "serve",
        "--only",
        "hosting",
        "--host",
        "127.0.0.1",
        "--port",
        "5058"
      ],
      "port": 5058,
      "autoPort": false
    },
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5057",
        "--directory",
        "public"
      ],
      "port": 5057,
      "autoPort": false
    }
  ]
}
