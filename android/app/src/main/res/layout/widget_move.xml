<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only simple layouts and views work here. Colours match the journal's dark theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="YOUR NEXT MOVE"
            android:textColor="#93a5ff"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/scan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Scan receipt"
            android:padding="10dp"
            android:src="@drawable/ic_receipt" />

        <TextView
            android:id="@+id/refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Refresh"
            android:gravity="center"
            android:text="↻"
            android:textColor="#a0a8c0"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Tap to set up"
        android:textColor="#e9ecf6"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/why"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Sign in with the family password and choose your name."
        android:textColor="#a0a8c0"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="#7d859b"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
