rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the family's logins can read or write: p1@journal.invalid, p2@journal.invalid, and the old shared
    // family login (still used by the Android widget and the Dearly cloud writer). Any other account is refused.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid in [
        "anhTfDbP4NS3efUYf1VnBTuXVTy2",  // p1
        "EeSDAXmlrtYRKL2uN3ANhXp9W6s1",  // p2
        "wYR0YCfeWmVz6CvPeoqTViI8NRc2"   // old shared family login
      ];
    }

    // Visitor counts for the landing page: visits/{country code} -> { n }. Anyone may read them,
    // and anyone may only add exactly 1 to one country's count. Nothing else about a visitor is stored.
    match /visits/{cc} {
      allow read: if true;
      allow create: if cc.matches('^[A-Z]{2}$') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
  }
}
