rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the one family login can read or write. Any other account is refused.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "wYR0YCfeWmVz6CvPeoqTViI8NRc2";
    }
  }
}
