rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LOCAL EMULATOR ONLY (npm run dev). Never deploy this file; production uses firestore.rules.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Visitor counts for the landing page: visits/{country code} -> { n }. Anyone may read them,
    // and anyone may only add exactly 1 to one country's count. Nothing else about a visitor is stored.
    match /visits/{cc} {
      allow read: if true;
      allow create: if cc.matches('^[A-Z]{2}$') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
  }
}
